# 本番環境用環境変数設定例
# このファイルをコピーして .env.prod として使用してください

# デプロイ設定
DEPLOY_PROD=true
CDK_DEFAULT_REGION=ap-northeast-1

# ドメイン設定（オプション）
PROD_DOMAIN_NAME=api.your-domain.com
PROD_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/12345678-1234-1234-1234-123456789012
PROD_HOSTED_ZONE_ID=Z1234567890ABC

# アラート設定
PROD_ALERT_EMAIL=admin@your-domain.com

# 予算設定
PROD_BUDGET_LIMIT=100

# セキュリティ設定
ENABLE_WAF=true
ENABLE_DETAILED_LOGGING=true

# パフォーマンス設定
API_CACHE_ENABLED=true
LAMBDA_RESERVED_CONCURRENCY=true

# ステージング環境設定（オプション）
DEPLOY_STAGING=false
STAGING_DOMAIN_NAME=staging-api.your-domain.com
STAGING_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/87654321-4321-4321-4321-210987654321
STAGING_HOSTED_ZONE_ID=Z0987654321XYZ
STAGING_ALERT_EMAIL=staging-admin@your-domain.com
STAGING_BUDGET_LIMIT=50