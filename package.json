{
  "name": "bedrock-video-analyzer",
  "version": "0.1.0",
  "description": "Amazon Bedrock TwelveLabs Pegasus 1.2を使用した動画解析デモWebアプリケーション",
  "bin": {
    "bedrock-video-analyzer": "bin/bedrock-video-analyzer.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "echo 'Linting...' && exit 0",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "synth": "cdk synth",
    "bootstrap": "cdk bootstrap",
    "deploy:dev": "cdk deploy VideoAnalyzerDevStack",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "destroy:prod": "bash scripts/destroy-prod.sh",
    "synth:prod": "DEPLOY_PROD=true cdk synth VideoAnalyzerProdStack",
    "synth:staging": "DEPLOY_STAGING=true cdk synth VideoAnalyzerStagingStack",
    "diff:prod": "DEPLOY_PROD=true cdk diff VideoAnalyzerProdStack",
    "diff:staging": "DEPLOY_STAGING=true cdk diff VideoAnalyzerStagingStack",
    "deploy:env:dev": "node scripts/deploy-with-env.js development",
    "deploy:env:staging": "node scripts/deploy-with-env.js staging",
    "deploy:env:prod": "node scripts/deploy-with-env.js production",
    "deploy:env:no-iam": "node scripts/deploy-with-env.js no-iam",
    "load-env": "node scripts/load-env.js",
    "ci:validate": "aws cloudformation validate-template --template-body file://fixed-cloudformation.yaml",
    "ci:deploy": "bash scripts/ci-deploy.sh",
    "ci:test": "npm test && cd lambda && npm test"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.954.0",
    "@aws-sdk/client-dynamodb": "^3.954.0",
    "@aws-sdk/client-s3": "^3.954.0",
    "@aws-sdk/lib-dynamodb": "^3.954.0",
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^29.4.0",
    "@types/node": "18.14.6",
    "@types/uuid": "^9.0.0",
    "aws-cdk": "2.110.1",
    "fast-check": "^3.15.0",
    "jest": "^29.4.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "~4.9.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.110.1",
    "constructs": "^10.0.0",
    "dotenv": "^16.6.1",
    "source-map-support": "^0.5.21",
    "uuid": "^9.0.0"
  }
}
