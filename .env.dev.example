# 開発環境用設定
# このファイルをコピーして .env.dev として使用してください

# AWS認証情報（開発環境用）
AWS_ACCESS_KEY_ID=your_dev_access_key_here
AWS_SECRET_ACCESS_KEY=your_dev_secret_key_here
AWS_DEFAULT_REGION=ap-northeast-1

# CDK設定
CDK_DEFAULT_ACCOUNT=252689085095
CDK_DEFAULT_REGION=ap-northeast-1

# デプロイ設定（開発環境）
DEPLOY_PROD=false
DEPLOY_STAGING=false
DEPLOY_NO_IAM=false

# 開発環境用設定
NODE_ENV=development
ENABLE_MOCK=true

# 開発用制限値（本番より緩い設定）
MAX_FILE_SIZE_BYTES=1073741824
MAX_DURATION_SECONDS=3600
DAILY_BUDGET=5.0
TEMP_FILE_RETENTION_DAYS=1
ANALYSIS_FILE_RETENTION_DAYS=3
PROCESSED_FILE_RETENTION_DAYS=7
QUERY_HISTORY_RETENTION_DAYS=30
MAX_STORAGE_USAGE_BYTES=5368709120
ENABLE_STORAGE_OPTIMIZATION=true

# Bedrock設定（開発環境）
PEGASUS_MODEL_ID=twelvelabs.pegasus-1-2
PEGASUS_MODEL_VERSION=1.0