# AWS認証情報
# 注意: 本番環境では IAM ロールの使用を推奨します
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-northeast-1

# CDK設定
CDK_DEFAULT_ACCOUNT=252689085095
CDK_DEFAULT_REGION=ap-northeast-1

# デプロイ設定
DEPLOY_PROD=false
DEPLOY_STAGING=false
DEPLOY_NO_IAM=false

# IAM作成権限不要版で使用（DEPLOY_NO_IAM=trueの場合）
LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/VideoAnalyzerLambdaRole

# 本番環境設定（DEPLOY_PROD=trueの場合）
PROD_DOMAIN_NAME=video-analyzer.example.com
PROD_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/12345678-1234-1234-1234-123456789012
PROD_HOSTED_ZONE_ID=Z1234567890ABC
PROD_ALERT_EMAIL=admin@example.com
PROD_BUDGET_LIMIT=100

# ステージング環境設定（DEPLOY_STAGING=trueの場合）
STAGING_DOMAIN_NAME=staging.video-analyzer.example.com
STAGING_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/87654321-4321-4321-4321-210987654321
STAGING_HOSTED_ZONE_ID=Z1234567890ABC
STAGING_ALERT_EMAIL=staging@example.com
STAGING_BUDGET_LIMIT=50

# Lambda環境変数
MAX_FILE_SIZE_BYTES=5368709120
MAX_DURATION_SECONDS=7200
DAILY_BUDGET=10.0
TEMP_FILE_RETENTION_DAYS=1
ANALYSIS_FILE_RETENTION_DAYS=7
PROCESSED_FILE_RETENTION_DAYS=30
QUERY_HISTORY_RETENTION_DAYS=90
MAX_STORAGE_USAGE_BYTES=10737418240
ENABLE_STORAGE_OPTIMIZATION=true

# Bedrock設定
PEGASUS_MODEL_ID=twelvelabs.pegasus-1-2
PEGASUS_MODEL_VERSION=1.0
ENABLE_MOCK=false

# 開発環境設定
NODE_ENV=production